<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Allow static files in public/ and assets/ to be served directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route all other requests through front controller
RewriteRule ^(.*)$ public/front.php [L,QSA]
</IfModule>
