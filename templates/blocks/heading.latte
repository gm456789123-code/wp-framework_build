{var $lvl = isset($attrs['level']) ? (int) $attrs['level'] : 2}
{if $lvl === 1}
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 my-6">{$innerHTML|noescape}</h1>
{elseif $lvl === 2}
    <h2 class="text-2xl font-bold tracking-tight text-slate-900 my-5">{$innerHTML|noescape}</h2>
{elseif $lvl === 3}
    <h3 class="text-xl font-bold tracking-tight text-slate-900 my-4">{$innerHTML|noescape}</h3>
{else}
    <h4 class="text-lg font-bold tracking-tight text-slate-900 my-3">{$innerHTML|noescape}</h4>
{/if}
