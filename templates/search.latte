<!DOCTYPE html>
<html lang="en" class="h-full bg-[#09090b] text-zinc-200 antialiased selection:bg-zinc-800 selection:text-white">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{$title} — {$siteName}</title>
    <meta name="robots" content="noindex, follow">
    {if !empty($logoUrl)}
    <link rel="icon" type="image/png" href="{$logoUrl}">
    {/if}
    <link rel="stylesheet" href="{$cssUrl}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
        code, pre, .font-mono { font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
    </style>
</head>
<body class="min-h-full flex flex-col justify-between p-6 sm:p-10 relative bg-[#09090b] text-zinc-200 antialiased overflow-x-hidden">

    <!-- Ambient Developer Background -->
    <div class="fixed inset-0 pointer-events-none z-0">
        <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[720px] h-[450px] bg-[radial-gradient(ellipse_at_center,rgba(56,189,248,0.07),transparent_70%)] blur-3xl"></div>
        <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.03)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.03)_1px,transparent_1px)] bg-[size:32px_32px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_40%,#000_40%,transparent_100%)]"></div>
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_50%,rgba(9,9,11,0.5)_100%)]"></div>
    </div>

    <!-- Header -->
    <header class="max-w-4xl w-full mx-auto flex items-center justify-between text-xs text-zinc-400 relative z-10 pb-6 border-b border-zinc-900">
        <a href="{$siteUrl !== '' ? $siteUrl : '/'}" class="flex items-center space-x-3 hover:opacity-80 transition">
            <img src="{$logoUrl}" alt="{$siteName} Logo" width="32" height="32" class="w-8 h-8 object-contain">
            <span class="font-semibold text-white text-sm">{$siteName}</span>
            <span class="px-2 py-0.5 rounded bg-emerald-950/60 border border-emerald-800/60 text-emerald-400 font-mono text-[10px]">Sovereign Engine</span>
        </a>
    </header>

    <!-- Main Content -->
    <main class="max-w-4xl w-full mx-auto flex-1 my-10 relative z-10 space-y-8">
        
        <!-- Search Bar -->
        <section class="space-y-3">
            <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">Search</h1>
            <form action="{$siteUrl !== '' ? $siteUrl : ''}/search" method="GET" class="flex gap-2 max-w-xl">
                <input type="text" name="q" value="{$query}" placeholder="Search pages and articles..."
                       class="flex-1 px-4 py-2.5 rounded-xl bg-zinc-900 border border-zinc-800 text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-zinc-600 focus:ring-1 focus:ring-zinc-600">
                <button type="submit"
                        class="px-5 py-2.5 rounded-xl bg-white text-zinc-950 font-medium text-sm hover:bg-zinc-200 transition shadow-sm">
                    Search
                </button>
            </form>
        </section>

        <!-- Search Results -->
        <section class="space-y-4">
            {if !empty($query)}
                <div class="text-xs text-zinc-500 font-mono">
                    Found {count($results)} result{if count($results) !== 1}s{/if} for <span class="text-zinc-300">"{$query}"</span>
                </div>
            {/if}

            {if empty($results)}
                <div class="p-8 rounded-2xl bg-zinc-900/30 border border-zinc-800/80 text-center space-y-2">
                    <p class="text-sm text-zinc-400">No matching pages found.</p>
                    <p class="text-xs text-zinc-600 font-mono">Try searching with different or more general keywords.</p>
                </div>
            {else}
                <div class="space-y-3">
                    {foreach $results as $item}
                        <article class="p-5 sm:p-6 rounded-2xl bg-zinc-900/30 border border-zinc-800/80 hover:border-zinc-700/80 transition space-y-2">
                            <h2 class="text-lg font-semibold text-white tracking-tight">
                                <a href="{$siteUrl !== '' ? $siteUrl : ''}/{$item->slug !== '' ? $item->slug : '?page_id=' . $item->id->value}" class="hover:text-sky-400 transition">
                                    {$item->title}
                                </a>
                            </h2>
                            {if !empty($item->excerpt)}
                                <p class="text-xs text-zinc-400 leading-relaxed line-clamp-2">{$item->excerpt}</p>
                            {/if}
                            <div class="flex items-center space-x-3 text-[11px] font-mono text-zinc-500 pt-1">
                                <span class="uppercase">{$item->locale->value}</span>
                                <span>&bull;</span>
                                <span>{$item->createdAt->format('Y-m-d')}</span>
                            </div>
                        </article>
                    {/foreach}
                </div>
            {/if}
        </section>

    </main>

    <!-- Footer -->
    <footer class="max-w-4xl w-full mx-auto flex flex-col sm:flex-row items-center justify-between text-xs text-zinc-500 font-mono gap-2 pt-6 border-t border-zinc-900 relative z-10">
        <div>
            {if !empty($isLocal)}<span>PHP {=\PHP_VERSION}</span><span class="mx-2">&bull;</span>{/if}
            <span>Sovereign Engine</span>
        </div>
    </footer>

</body>
</html>
