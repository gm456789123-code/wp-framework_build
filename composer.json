{
    "name": "sovereign/wp-framework",
    "description": "Production Sovereign Engine - Headless WordPress with Hexagonal DDD",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "latte/latte": "^3.0",
        "robmorgan/phinx": "^0.16",
        "symfony/console": "^7.1",
        "symfony/process": "^7.1",
        "thecodingmachine/safe": "^3.0"
    },
    "require-dev": {
        "pestphp/pest": "^2.36",
        "pestphp/pest-plugin-arch": "^2.7",
        "phpstan/phpstan": "^2.2",
        "vimeo/psalm": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "stan": "phpstan analyse",
        "psalm": "psalm",
        "test": "pest",
        "check": [
            "@stan",
            "@psalm",
            "@test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
